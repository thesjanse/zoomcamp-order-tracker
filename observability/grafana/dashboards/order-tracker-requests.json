        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.3",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(order_lookup_requests_total{service_name=~\"$service\", http_route=~\"$route\"}[$__range]))",
