    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Order lookups counted over the whole dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
